{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "listenerIp",
      "type": "promptString",
      "description": "Listener IP address",
      "default": "127.0.0.1"
    },
    {
      "id": "listenerPort",
      "type": "promptString",
      "description": "UDP port to listen on",
      "default": "5000"
    },
    {
      "id": "talkerPort",
      "type": "promptString",
      "description": "UDP port to send to",
      "default": "5000"
    }
  ],
  "tasks": [
    {
      "label": "Install dependencies (Debian/Ubuntu)",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/install-dependencies.sh",
      "problemMatcher": []
    },
    {
      "label": "Configure Meson",
      "type": "shell",
      "command": "if [ -f build/meson-private/coredata.dat ]; then meson setup --reconfigure build; else meson setup build; fi",
      "problemMatcher": []
    },
    {
      "label": "Format talker",
      "type": "process",
      "command": "clang-format",
      "args": ["-i", "src/talker/main.c", "src/talker/talker.c", "src/talker/talker.h"],
      "problemMatcher": []
    },
    {
      "label": "Start talker",
      "type": "process",
      "command": "${workspaceFolder}/scripts/start-node.sh",
      "args": ["talker", "${input:listenerIp}", "${input:talkerPort}"],
      "problemMatcher": []
    },
    {
      "label": "Start listener",
      "type": "process",
      "command": "${workspaceFolder}/scripts/start-node.sh",
      "args": ["listener", "${input:listenerPort}"],
      "problemMatcher": []
    }
  ]
}



