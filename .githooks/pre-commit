#!/usr/bin/env bash
# filepath: .githooks/pre-commit
set -euo pipefail

command -v clang-format >/dev/null || {
  echo "pre-commit: clang-format is required" >&2
  exit 1
}

failed=0
while IFS= read -r -d '' file; do
  if ! git show ":$file" |
    clang-format --dry-run --Werror --style=file --assume-filename="$file" >/dev/null; then
    echo "pre-commit: formatting check failed: $file" >&2
    failed=1
  fi
done < <(git diff --cached --name-only -z --diff-filter=ACMR -- '*.c' '*.h')

(( failed == 0 )) || exit 1
git diff --cached --check